{
  "experiment": "DrawerClose DDPG AER no-HER three-arm block",
  "benchmark": "MetaWorld drawer-close-v3",
  "reward_type": "sparse",
  "backbone": "DDPG",
  "arms": ["ddpg_er", "ddpg_annealing_er", "ddpg_aer"],
  "seeds": [1, 2, 3, 4, 5],
  "total_steps": 2000000,
  "max_episode_steps": 200,
  "batch_size": 256,
  "buffer_capacity": 300000,
  "her_ratio": 0.0,
  "start_steps": 10000,
  "warmup_steps": 5000,
  "updates_per_step": 1,
  "hidden_dim": 256,
  "gamma": 0.98,
  "tau": 0.005,
  "actor_lr": 0.0003,
  "critic_lr": 0.0003,
  "noise_std": 0.2,
  "policy_delay": 1,
  "target_policy_noise": 0.0,
  "target_noise_clip": 0.0,
  "aer_lambda0": 2.5,
  "aer_alpha": 0.6666666666666666,
  "aer_cosine_eps": 1e-8,
  "aer_similarity_input": "observation concatenated with original desired_goal",
  "aer_similarity": "raw cosine",
  "aer_candidate_sampling": "uniform with replacement",
  "aer_candidate_count": "ceil(lambda_t * batch_size)",
  "aer_importance_sampling": false,
  "eval_freq": 10000,
  "eval_episodes": 20,
  "final_eval_episodes": 100,
  "success_terminates": false,
  "timeout_bootstrap": true,
  "save_step_checkpoints": false,
  "output_root": "metaworld_Drawer_Close_DDPG_AER/runs"
}
